{
  "name": "@innonova/upkit",
  "version": "0.1.0",
  "description": "An UnrealScript decompiler and recompiler for XCOM: Enemy Within's packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innonova/upkit.git"
  },
  "homepage": "https://github.com/innonova/upkit#readme",
  "keywords": [
    "xcom",
    "unrealscript",
    "unreal-engine-3",
    "decompiler",
    "modding"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "upkit": "dist/upkit.mjs"
  },
  "files": [
    "dist/",
    "lib/",
    "notes/"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "typescript": "~6.0.0"
  },
  "exports": {
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
